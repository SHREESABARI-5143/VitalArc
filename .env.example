# =================================================================
# VitalArc Environment Configuration Template
# =================================================================

# Server & Runtime Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Sessions
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# AI & LLM APIs (For Clinical RAG Engine)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Supabase Storage & Database (Optional for user auth & clinical records)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ML Inference Configuration
MODEL_CLASSIFIER_PATH=eye_cnn_model.h5
MODEL_SEGFORMER_PATH=segformer.pth
DEVICE=cpu
